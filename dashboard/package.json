{
  "name": "monstermq-dashboard",
  "private": true,
  "version": "1.8.25",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "NODE_ENV=development electron .",
    "electron:build": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "@siemens/ix": "^4.3.0",
    "@siemens/ix-icons": "^3.4.0",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "marked": "^18.0.7"
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.7",
    "vite": "^6.4.2"
  },
  "overrides": {
    "glob": "^11.0.0",
    "rimraf": "^5.0.10",
    "brace-expansion": "^2.0.1",
    "boolean": "npm:is-boolean@^1.0.0"
  },
  "build": {
    "appId": "com.monstermq.desktop",
    "productName": "MonsterMQ-Dashboard",
    "publish": null,
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-${arch}.${ext}"
    }
  }
}
